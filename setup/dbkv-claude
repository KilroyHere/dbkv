#!/usr/bin/env bash
# dbkv-claude: keep ONE Claude Code + Remote Control session alive on a Perlmutter login node.
#
#   dbkv-claude start  [NAME]  start it on this login node (no-op if already alive on its recorded node)
#   dbkv-claude status [NAME]  which node, is tmux/claude alive, last log lines
#   dbkv-claude attach [NAME]  open the tmux session (hops to the recorded node if needed)
#   dbkv-claude peek   [NAME]  one-screen view: git, Status, Slurm jobs, last chat messages
#   dbkv-claude stop   [NAME]  stop the loop and the session
# NAME defaults to "dbkv" (the main D2 session, unchanged). Any other NAME, e.g. "expert", runs a separate
# session: tmux "dbkv-NAME", Remote Control "dbkv-NAME", working dir = the git worktree "<repo>-NAME",
# own node/stop/log files.
#
# From the Mac:  ssh -t perlmutter dbkv-claude attach
# Installed as a symlink: ~/.local/bin/dbkv-claude -> $DBKV_REPO/setup/dbkv-claude
set -uo pipefail

MAIN=/global/cfs/cdirs/m4999/team19/ap2568/dbkv
SCRIPT=$MAIN/setup/dbkv-claude
CMD=${1:-status}
NAME=${2:-dbkv}
if [[ "$NAME" == "dbkv" ]]; then          # default: identical to the original single-session setup
  REPO=$MAIN; SESSION=dbkv; RC_NAME=dbkv-perlmutter
  NODE_FILE=$HOME/.dbkv-claude-node; STOP_FILE=$HOME/.dbkv-claude-stop; LOG=$SCRATCH/dbkv/logs/claude-rc.log
  STATUS_DOC=docs/PLAN.md; PROJ_GLOB="*team19-ap2568-dbkv"
else
  REPO=$MAIN-$NAME; SESSION=dbkv-$NAME; RC_NAME=dbkv-$NAME
  NODE_FILE=$HOME/.dbkv-claude-node-$NAME; STOP_FILE=$HOME/.dbkv-claude-stop-$NAME
  LOG=$SCRATCH/dbkv/logs/claude-rc-$NAME.log
  STATUS_DOC=docs/EXPERT.md; PROJ_GLOB="*team19-ap2568-dbkv-$NAME"
  [[ "$NAME" == "expert" ]] || STATUS_DOC=docs/${NAME^^}.md
fi
CLAUDE=$HOME/.local/bin/claude
here=$(hostname)
node=$(cat "$NODE_FILE" 2>/dev/null || true)

on_node() {  # run a command on the recorded node (locally if we're already there)
  if [[ -z "$node" || "$node" == "$here" ]]; then bash -c "$1"; else ssh -o BatchMode=yes "$node" "$1" 2>/dev/null; fi
}
alive() { [[ -n "$node" ]] && on_node "tmux has-session -t $SESSION 2>/dev/null"; }

loop() {  # runs inside tmux; restarts claude if it exits
  rm -f "$STOP_FILE"; mkdir -p "$(dirname "$LOG")"; cd "$REPO" || exit 1
  while [[ ! -f "$STOP_FILE" ]]; do
    echo "$(date -Is) $(hostname) starting (try --continue)" >> "$LOG"
    # --continue reattaches to the session recorded for this dir (only within ~4 h); otherwise start fresh.
    # Named sessions (worktrees) always start fresh: Claude treats worktrees of one repo as one project, so
    # --continue there can grab the main session's conversation (seen Nov 5). Their memory is docs/<NAME>.md.
    if [[ "$NAME" == "dbkv" ]]; then
      "$CLAUDE" remote-control --continue --name "$RC_NAME" \
        || "$CLAUDE" remote-control --name "$RC_NAME"
    else
      "$CLAUDE" remote-control --name "$RC_NAME"
    fi
    echo "$(date -Is) claude exited with $?; restarting in 30 s" >> "$LOG"
    sleep 30
  done
}

case "$CMD" in
  start)
    if alive; then echo "already running on $node (tmux '$SESSION')"; exit 0; fi
    [[ -d "$REPO" ]] || { echo "no working dir $REPO (create the worktree first)"; exit 1; }
    tmux new-session -d -s "$SESSION" -c "$REPO" "bash $SCRIPT _loop $NAME"
    echo "$here" > "$NODE_FILE"
    echo "started on $here; open it in the Claude app as '$RC_NAME', or: dbkv-claude attach" ;;
  _loop) loop ;;
  status)
    echo "recorded node: ${node:-none}   (you are on $here)"
    if alive; then echo "tmux '$SESSION': alive"; on_node "pgrep -u $USER -af 'claude remote-control' | head -2"
    else echo "tmux '$SESSION': NOT running -> dbkv-claude start${2:+ $NAME}"; fi
    tail -3 "$LOG" 2>/dev/null ;;
  attach)
    alive || { echo "not running; run: dbkv-claude start"; exit 1; }
    if [[ "$node" == "$here" ]]; then exec tmux attach -t "$SESSION"; else exec ssh -t "$node" tmux attach -t "$SESSION"; fi ;;
  peek)  # one-screen view of what the session is doing (for you or the Mac Claude: ssh perlmutter dbkv-claude peek)
    [[ "$NAME" == dbkv ]] && echo "== session" || echo "== session $SESSION ($RC_NAME)"; alive && echo "alive on $node" || echo "NOT running"
    echo "== git"; git -C "$REPO" log --oneline -3; git -C "$REPO" status --short | head -5
    if [[ "$STATUS_DOC" == docs/PLAN.md ]]; then
      echo "== status (docs/PLAN.md)"; sed -n '/^## Status/,/^\*\*Next/p' "$REPO/docs/PLAN.md" | tail -n +3
    else
      echo "== status ($STATUS_DOC)"; sed -n '1,25p' "$REPO/$STATUS_DOC" 2>/dev/null || echo "(no $STATUS_DOC yet)"
    fi
    echo "== slurm"; squeue -u "$USER" -o "%.10i %.20j %.8T %.10M %.6D %R" 2>/dev/null
    echo "== recent jobs (logs/jobs.tsv)"; tail -5 "$SCRATCH/dbkv/logs/jobs.tsv" 2>/dev/null
    echo "== last messages"
    t=$(ls -t "$HOME"/.claude/projects/$PROJ_GLOB/*.jsonl 2>/dev/null | head -1)
    [[ -n "$t" ]] && tail -200 "$t" | /usr/bin/python3 -c '
import sys, json
out = []
for line in sys.stdin:
    try: m = json.loads(line)
    except Exception: continue
    if m.get("type") not in ("user", "assistant"): continue
    c = m.get("message", {}).get("content")
    if isinstance(c, list):
        c = " ".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
    if c and c.strip(): out.append("[%s] %s" % (m["type"], " ".join(c.split())[:300]))
print("\n".join(out[-6:]))' ;;
  stop)
    touch "$STOP_FILE"; on_node "tmux kill-session -t $SESSION 2>/dev/null"; echo "stopped" ;;
  *) sed -n '2,12p' "$0" ;;
esac
